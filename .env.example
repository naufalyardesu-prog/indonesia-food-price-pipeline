# Salin file ini menjadi .env, lalu sesuaikan nilainya
AIRFLOW_UID=1000

# PostgreSQL warehouse
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=food_price
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=ganti_password_ini

# Koneksi Airflow ke warehouse (samakan user dan password dengan di atas)
AIRFLOW_CONN_WAREHOUSE=postgresql://warehouse:ganti_password_ini@warehouse:5432/food_price
